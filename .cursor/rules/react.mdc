# React 开发规范

## 新特性

### 1. use() Hook - 简化数据获取

```typescript
import { use } from 'react';

function UserProfile({ userPromise }) {
  const user = use(userPromise);
  return <div>{user.name}</div>;
}

const ThemeContext = createContext(null);
function App() {
  const theme = use(ThemeContext);
}
```

### 2. Actions - 表单处理

```typescript
'use client';
import { useActionState, useFormStatus } from 'react';

async function createUser(formData: FormData) {
  'use server';
  const name = formData.get('name');
  await db.user.create({ name });
  revalidatePath('/users');
}

const [state, formAction, isPending] = useActionState(createUser, null);

function SubmitButton() {
  const { pending } = useFormStatus();
  return <button disabled={pending}>{pending ? '提交中...' : '提交'}</button>;
}
```

### 3. useOptimistic - 乐观更新

```typescript
function LikeButton({ likes, onLike }) {
  const [optimisticLikes, addOptimisticLike] = useOptimistic(
    likes,
    (state, newLike) => state + newLike
  );

  return (
    <button onClick={async () => {
      addOptimisticLike(1);
      await onLike();
    }}>
      {optimisticLikes} Likes
    </button>
  );
}
```

### 4. useDeferredValue - 延迟渲染

```typescript
function SearchResults({ query }) {
  const deferredQuery = useDeferredValue(query);
  const results = useDeferredValue(useMemo(
    () => searchProducts(deferredQuery),
    [deferredQuery]
  ));

  return <ProductList products={results} />;
}
```

### 5. useFormStatus 与 useFormAction

```typescript
function SubmitButton() {
  const { pending, data, method } = useFormStatus();
  return <button disabled={pending}>{pending ? '提交中' : '提交'}</button>;
}
```

## 最佳实践

1. 使用 Server Actions 处理表单提交
2. 用 useOptimistic 实现即时反馈
3. 用 useDeferredValue 优化大数据渲染
4. 区分客户端和服务器端组件
5. 使用 'use client' 标记客户端组件
